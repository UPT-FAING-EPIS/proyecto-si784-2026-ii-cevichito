# ==========================================================================
# Variables de entorno de SAST Studio. Copia este archivo a .env (no lo subas
# al repositorio) y rellena los valores. Los secretos NO tienen valor por
# defecto: si falta uno, la aplicación no arranca.
# Genera secretos con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==========================================================================

ENVIRONMENT=dev                       # dev | test | prod

# --- Secretos obligatorios (>= 32 bytes) ---
SECRET_KEY=
SESSION_HMAC_KEY=

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://sast:CAMBIAR@db:5432/sast
POSTGRES_PASSWORD=CAMBIAR

# --- Google OIDC (obligatorio en prod) ---
# Redirect URI autorizada en Google Cloud Console: <PUBLIC_ORIGIN>/api/v1/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_HOSTED_DOMAIN=universidad.edu    # opcional: restringe el dominio de las cuentas

# --- Otro proveedor OIDC (opcional, en lugar de Google) ---
# Microsoft Entra, Keycloak, el SSO de la universidad... Los endpoints se leen de
# <OIDC_ISSUER>/.well-known/openid-configuration. Con OIDC_ISSUER definido, usa
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET (alias de GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET).
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Microsoft          # texto del botón "Continuar con ..."

# --- Acceso de desarrollo (solo ENVIRONMENT=dev) ---
DEV_LOGIN_ENABLED=false

# --- Web: la SPA y la API se sirven desde el MISMO origen ---
PUBLIC_ORIGIN=http://localhost:8080
TRUST_PROXY=false

# --- Límites (valores por defecto razonables) ---
# MAX_UPLOAD_MB=25
# SCAN_TIMEOUT_S=300
# SCANS_PER_HOUR=30
# MAX_RUNNING_SCANS_PER_USER=2
# RETENTION_DAYS=90
# RATELIMIT_STORAGE_URI=memory://      # en producción: redis://valkey:6379/0
# GITHUB_TOKEN=                        # opcional, solo servidor (más cuota de descargas)
LOG_LEVEL=INFO

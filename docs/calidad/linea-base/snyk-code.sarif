es": {"isAutofixable": true,"priorityScore": 607,"priorityScoreFactors": [  {"label": true,"type": "multipleOccurrence"  },  {"label": true,"type": "hotFileSource"  }]}},{"ruleId": "python/Deserialization","ruleIndex": 2,"level": "error","message": {"text":"Unsanitized input from the HTTP request body flows into yaml.load, where it is used to deserialize an object. This may result in an Unsafe Deserialization vulnerability.","markdown":"Unsanitized input from {0} {1} into {2}, where it is used to deserialize an object. This may result in an Unsafe Deserialization vulnerability.","arguments": ["[the HTTP request body](0)","[flows](1),(2),(3)","[yaml.load](4)"]},"locations": [{  "id": 0,  "physicalLocation": {"artifactLocation": {  "uri": "samples/vulnerable_sample.py",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":85,  "endLine":85,  "startColumn":5,  "endColumn":14}  }}],"fingerprints": {"identity": "f6d59a15-1153-4edd-8b1a-215d0533be35","0": "31779e23df474bc1dc804508b7fe8f84a021927456f0f3799fb4ed3c73f481c4","1": "96d56886.1c6650e9.b10b935c.5bc6639a.4a85f8d4.ba14daf2.23b01c38.3062db2a.96d56886.73ba707b.a832003e.5bc6639a.4a85f8d4.fb8be710.23b01c38.3062db2a","snyk/asset/finding/v1": "f6d59a15-1153-4edd-8b1a-215d0533be35"},"codeFlows": [{"threadFlows": [{"locations": [{"location": {"id": 0,"physicalLocation": {"artifactLocation": {  "uri": "samples/vulnerable_sample.py",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":83,  "endLine":83,  "startColumn":11,  "endColumn":23}}}},{"location": {"id": 1,"physicalLocation": {"artifactLocation": {  "uri": "samples/vulnerable_sample.py",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":83,  "endLine":83,  "startColumn":11,  "endColumn":23}}}},{"location": {"id": 2,"physicalLocation": {"artifactLocation": {  "uri": "samples/vulnerable_sample.py",  "uriBaseId": "%SRCROOT%"},"region": {  "startLine":83,  "endLine":83,  "startColumn":5,  "endColumn":23}}}},{"location": {"id": 3,"physicalLocation": {"artifactLocation": {